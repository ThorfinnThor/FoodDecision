NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_OPERATOR_NAME=Your legal name or company
NEXT_PUBLIC_PRIVACY_CONTACT=privacy@example.com
STATIC_EXPORT_SOURCE=fixtures
STATIC_EXPORT_MAX_BYTES=1048576

# Supabase REST ingestion
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace-with-backend-secret-key
# Legacy fallback only:
SUPABASE_SERVICE_ROLE_KEY=

# Open Food Facts ingestion
OFF_USER_AGENT=compareyourfood.com/0.1 (contact: you@example.com)
OFF_COUNTRY=Germany
OFF_MARKET=DE
OFF_CATEGORY_SLUGS=all
OFF_MAX_PAGES=1
OFF_PAGE_SIZE=50
OFF_REQUEST_DELAY_MS=7000
OFF_FETCH_RETRIES=4
OFF_FETCH_RETRY_BASE_MS=10000
OFF_CONTINUE_ON_CATEGORY_ERROR=true
OFF_UPSERT_BATCH_SIZE=100

# GitHub Actions Supabase migration workflow
SUPABASE_ACCESS_TOKEN=replace-with-supabase-access-token
SUPABASE_PROJECT_REF=replace-with-project-ref
SUPABASE_DB_PASSWORD=replace-with-database-password

# GitHub Actions Vercel deployment workflow
VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/replace-with-hook-id
