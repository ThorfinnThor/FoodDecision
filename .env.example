NEXT_PUBLIC_SITE_URL=http://localhost:3000
STATIC_EXPORT_SOURCE=fixtures
STATIC_EXPORT_MAX_BYTES=1048576

# Supabase REST ingestion
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Open Food Facts ingestion
OFF_USER_AGENT=food-decision-engine/0.1 (contact: you@example.com)
OFF_COUNTRY=Germany
OFF_MAX_PAGES=1
OFF_PAGE_SIZE=50
OFF_REQUEST_DELAY_MS=7000

# GitHub Actions Supabase migration workflow
SUPABASE_ACCESS_TOKEN=replace-with-supabase-access-token
SUPABASE_PROJECT_REF=replace-with-project-ref
SUPABASE_DB_PASSWORD=replace-with-database-password

# GitHub Actions Vercel deployment workflow
VERCEL_TOKEN=replace-with-vercel-token
VERCEL_ORG_ID=replace-with-vercel-org-id
VERCEL_PROJECT_ID=replace-with-vercel-project-id
