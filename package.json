{
  "name": "food-decision-engine",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "next:dev": "next dev",
    "build": "npm run export:static-data && npm run seo:validate && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "next:build": "npm run export:static-data && npm run seo:validate && next build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --experimental-strip-types --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "export:static-data": "node --experimental-strip-types scripts/export/static-data.ts",
    "export:static-data:supabase": "STATIC_EXPORT_SOURCE=supabase node --experimental-strip-types scripts/export/static-data.ts",
    "seo:validate": "node --experimental-strip-types scripts/seo/validate-seo.ts",
    "ingest:off": "node scripts/ingest/open-food-facts.mjs",
    "ingest:off:dry": "node scripts/ingest/open-food-facts.mjs --dry-run",
    "normalize:off": "node --experimental-strip-types scripts/normalize/open-food-facts.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
